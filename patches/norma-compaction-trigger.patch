 }
-func (c *Compactor) autoThreshold() int  { return c.effectiveWindow() - c.buffer() }
+func (c *Compactor) autoThreshold() int {
+	base := c.effectiveWindow() - c.buffer()
+	// An explicit ratio may only pull the trigger EARLIER (min), never push it
+	// later: relaxing the default would be a silent policy change.
+	if r := c.cfg.AutoCompactRatio; r > 0 && r < 1 {
+		if t := int(float64(c.effectiveWindow()) * r); t > 0 && t < base {
+			return t
+		}
+	}
+	return base
+}
 func (c *Compactor) microThreshold() int { return c.effectiveWindow() * 6 / 10 }
 
