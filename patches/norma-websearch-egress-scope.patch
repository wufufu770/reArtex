+// WebSearchScopeFunc judges one web_search destination BEFORE the request
+// leaves the machine.
+//
+// host is the destination the provider is about to talk to; backend is the
+// provider's name (ddgs / brave-free / tavily / deepseek). allowed=false
+// stops the request; reason is surfaced to the caller.
+//
+// WHY THE HOST DECIDES (rather than the SDK): whether a destination is
+// platform infrastructure or an unattributed egress is a policy question the
+// host application owns. The SDK must not hard-code a destination allowlist:
+// that list would be a security boundary living in a vendored dependency.
+type WebSearchScopeFunc func(ctx context.Context, host, backend string) (allowed bool, reason string)
+
+// webSearchScopeHook is the process-wide scope hook (nil = no hook installed).
+//
+// It exists so the host can install ONE hook at startup instead of threading a
+// callback through every session's Options. Installed before any session runs,
+// read-only afterwards.
+var webSearchScopeHook atomic.Pointer[WebSearchScopeFunc]
+
+// SetWebSearchEgressScope installs the process-wide web_search scope hook.
+//
+// Passing nil removes it (back to no scope check, the pre-hook behaviour).
+func SetWebSearchEgressScope(fn WebSearchScopeFunc) {
+	if fn == nil {
+		webSearchScopeHook.Store(nil)
+		return
+	}
+	webSearchScopeHook.Store(&fn)
+}
+
+// webSearchScope returns the installed hook (nil = none installed).
+func webSearchScope() WebSearchScopeFunc {
+	if p := webSearchScopeHook.Load(); p != nil {
+		return *p
+	}
+	return nil
+}
