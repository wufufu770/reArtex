+// scopeSearchProvider wraps a provider with the destination-scope hook.
+//
+// The hook runs BEFORE the provider issues its request, so a denied
+// destination never leaves the machine. With no hook installed the provider is
+// returned untouched: an uninstalled host keeps today's behaviour instead of
+// breaking the tool.
+func scopeSearchProvider(inner searchProvider, endpoint string, scope WebSearchScopeFunc) searchProvider {
+	if scope == nil {
+		scope = webSearchScope()
+	}
+	if scope == nil {
+		return inner
+	}
+	host := ""
+	if u, err := url.Parse(endpoint); err == nil {
+		host = u.Hostname()
+	}
+	return &scopedSearchProvider{inner: inner, host: host, scope: scope}
+}
+
+// scopedSearchProvider is the scope-checking wrapper around a search provider.
+type scopedSearchProvider struct {
+	inner searchProvider
+	host  string
+	scope WebSearchScopeFunc
+}
+
+func (p *scopedSearchProvider) Name() string { return p.inner.Name() }
+
+func (p *scopedSearchProvider) Search(ctx context.Context, query string, limit int) ([]SearchResult, error) {
+	allowed, reason := p.scope(ctx, p.host, p.inner.Name())
+	if !allowed {
+		return nil, fmt.Errorf("web_search 出网被拒（目的地 %q）：%s", p.host, reason)
+	}
+	return p.inner.Search(ctx, query, limit)
+}
+
+// Timeout forwards the inner provider's wall-clock cap.
+//
+// It MUST exist on the wrapper: the runner type-asserts for it, and a wrapper
+// without it would silently fall back to the runner's default, which would cut
+// off the deepseek backend's longer budget. When the inner provider declares no
+// cap, the wrapper reports the runner's default so behaviour is unchanged.
+func (p *scopedSearchProvider) Timeout() time.Duration {
+	if tp, ok := p.inner.(interface{ Timeout() time.Duration }); ok {
+		return tp.Timeout()
+	}
+	return defaultWebSearchTimeout
+}
