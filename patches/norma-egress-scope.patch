+// webFetchDirectFallbackEnabled reports whether the no-proxy retry is allowed.
+//
+// Default OFF: the direct retry bypasses the recording proxy, so the request
+// leaves the machine with no task-identity token — neither scope-checked nor
+// captured. Set NORMA_WEBFETCH_DIRECT_FALLBACK=1 to opt in explicitly.
+func webFetchDirectFallbackEnabled() bool {
+	v := strings.TrimSpace(os.Getenv("NORMA_WEBFETCH_DIRECT_FALLBACK"))
+	return v == "1" || strings.EqualFold(v, "true")
+}
