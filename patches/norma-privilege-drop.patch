diff --git a/tool/privdrop/privdrop.go b/tool/privdrop/privdrop.go
new file mode 100644
index 0000000..c71179a
--- /dev/null
+++ b/tool/privdrop/privdrop.go
@@ -0,0 +1,29 @@
+// Package privdrop defines the identity that agent-spawned child processes run
+// under, and the helper that drops a child to it.
+//
+// Why it exists: in the container the platform process runs as root (the base
+// image defaults to root), so agent-spawned children inherit that identity.
+// The platform's own credential files — a docker secret mounted at
+// /run/secrets/pg_dsn, mode 0600 but fully readable by root — are then readable
+// by the agent, and the agent holding the connection string can bypass every
+// application-layer scope check and talk to the database directly. Dropping
+// tool children to a dedicated unprivileged UID breaks that read path.
+//
+// Why 65534 (nobody): it is the last unprivileged UID that essentially every
+// base image ships. Not 0 — that is the platform process's own identity, so
+// dropping to it is no drop at all. Not 1000 — the mounted db credential file
+// in the container is owned by uid 1000 with mode 0600, so a child running as
+// 1000 still reads it and the drop is theatre.
+//
+// The UID/GID live here so that there is exactly one source of truth: the host
+// application derives its own agent identity from these constants instead of
+// redeclaring them.
+package privdrop
+
+const (
+	// AgentUID is the dedicated unprivileged UID for agent-spawned children.
+	AgentUID = 65534
+	// AgentGID is the dedicated unprivileged GID for agent-spawned children;
+	// it has the same value as AgentUID.
+	AgentGID = 65534
+)
diff --git a/tool/privdrop/privdrop_linux.go b/tool/privdrop/privdrop_linux.go
new file mode 100644
index 0000000..478e354
--- /dev/null
+++ b/tool/privdrop/privdrop_linux.go
@@ -0,0 +1,27 @@
+//go:build linux
+
+package privdrop
+
+import (
+	"os"
+	"syscall"
+)
+
+// ProcAttr returns the SysProcAttr that drops a child to the agent identity.
+//
+// NoSetGroups stays false: Go clears the supplementary groups with
+// setgroups(0) before setgid/setuid, so the child does not keep the platform
+// process's groups (the root group) around.
+func ProcAttr() *syscall.SysProcAttr {
+	return &syscall.SysProcAttr{
+		Credential: &syscall.Credential{Uid: AgentUID, Gid: AgentGID},
+	}
+}
+
+// CanDrop reports whether this process can drop a child to the agent identity.
+//
+// setuid/setgid need CAP_SETUID/CAP_SETGID, so only root (or a process holding
+// both capabilities) can do it. A non-root deployment (desktop build, local
+// development) gets false — there the child keeps the platform identity, and
+// the tools must not stop working just because they cannot be dropped.
+func CanDrop() bool { return os.Geteuid() == 0 }
diff --git a/tool/privdrop/privdrop_linux_test.go b/tool/privdrop/privdrop_linux_test.go
new file mode 100644
index 0000000..d775739
--- /dev/null
+++ b/tool/privdrop/privdrop_linux_test.go
@@ -0,0 +1,53 @@
+//go:build linux
+
+package privdrop
+
+import (
+	"os"
+	"testing"
+)
+
+// The drop has to land on a dedicated unprivileged UID: not 0 (the platform
+// process's own identity, so no drop at all) and not 1000 (the container's
+// mounted db credential file is owned by uid 1000 with mode 0600, so a child
+// running as 1000 still reads it).
+func TestAgentIdentityIsDedicatedNonPrivileged(t *testing.T) {
+	if AgentUID == 0 {
+		t.Fatal("AgentUID 不能是 0：那是平台进程自己的身份，降权等于没降")
+	}
+	if AgentUID == 1000 {
+		t.Fatal("AgentUID 不能是 1000：db 凭据文件(/run/secrets/pg_dsn)属主就是 1000，0600 挡不住它")
+	}
+	if AgentGID == 0 {
+		t.Fatal("AgentGID 不能是 0")
+	}
+	if AgentGID != AgentUID {
+		t.Fatalf("AgentGID(%d) 必须与 AgentUID(%d) 同值", AgentGID, AgentUID)
+	}
+}
+
+// On Linux the helper must hand back a credential carrying the agent identity,
+// otherwise the spawn sites would silently run their children as the platform
+// identity.
+func TestProcAttrCarriesAgentIdentity(t *testing.T) {
+	attr := ProcAttr()
+	if attr == nil {
+		t.Fatal("Linux 上 ProcAttr 不能是 nil：否则工具子进程仍以平台身份(root)运行")
+	}
+	if attr.Credential == nil {
+		t.Fatal("ProcAttr 必须带上 Credential，否则不会发生降权")
+	}
+	if attr.Credential.Uid != AgentUID {
+		t.Fatalf("Credential.Uid = %d，期望 %d", attr.Credential.Uid, AgentUID)
+	}
+	if attr.Credential.Gid != AgentGID {
+		t.Fatalf("Credential.Gid = %d，期望 %d", attr.Credential.Gid, AgentGID)
+	}
+}
+
+// The drop needs CAP_SETUID/CAP_SETGID, so it is only available to root.
+func TestCanDropTracksRoot(t *testing.T) {
+	if got, want := CanDrop(), os.Geteuid() == 0; got != want {
+		t.Fatalf("CanDrop() = %v，期望 %v", got, want)
+	}
+}
diff --git a/tool/privdrop/privdrop_other.go b/tool/privdrop/privdrop_other.go
new file mode 100644
index 0000000..6874b81
--- /dev/null
+++ b/tool/privdrop/privdrop_other.go
@@ -0,0 +1,16 @@
+//go:build !linux
+
+package privdrop
+
+import "syscall"
+
+// ProcAttr returns nil on non-Linux platforms: dropping via setuid is Linux
+// semantics.
+//
+// The desktop builds (macOS/Windows) are not part of this isolation's threat
+// model — there is no "root platform inside a container + mounted credential
+// file" premise, so the platform identity is kept.
+func ProcAttr() *syscall.SysProcAttr { return nil }
+
+// CanDrop returns false on non-Linux platforms: there is no setuid drop there.
+func CanDrop() bool { return false }
diff --git a/tool/privdrop/privdrop_other_test.go b/tool/privdrop/privdrop_other_test.go
new file mode 100644
index 0000000..aadc85c
--- /dev/null
+++ b/tool/privdrop/privdrop_other_test.go
@@ -0,0 +1,19 @@
+//go:build !linux
+
+package privdrop
+
+import "testing"
+
+// Off Linux there is no setuid drop: the helper must report "no drop" instead
+// of failing hard, so the spawn sites keep the platform identity.
+func TestProcAttrIsNilOffLinux(t *testing.T) {
+	if attr := ProcAttr(); attr != nil {
+		t.Fatalf("非 Linux 上 ProcAttr 必须是 nil，实际返回 %+v", attr)
+	}
+}
+
+func TestCanDropIsFalseOffLinux(t *testing.T) {
+	if CanDrop() {
+		t.Fatal("非 Linux 上 CanDrop 必须是 false")
+	}
+}
