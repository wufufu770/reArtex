+// defaultForegroundTimeout is how long a foreground command may run before the
+// tool hands control back to the agent.
+//
+// Why 60s by default (was 120s): a foreground command that hangs blocks the
+// agent for the whole timeout, and the agent cannot do anything useful while it
+// waits — no planning, no writing findings down, no reacting to a finding it
+// already has. The shorter the block, the sooner the agent regains control.
+// The SDK already moves an over-long foreground command to the background, so
+// shortening this does NOT lose the command: it returns immediately and the
+// agent reads the output later.
+//
+// AGENT_CORE_TOOL_TIMEOUT_SEC overrides it; the value is clamped to [5s, 600s].
+// The tool description and prompt are generated from the RESOLVED value, so the
+// contract shown to the model never contradicts the behaviour.
+func defaultForegroundTimeout() time.Duration {
+	d := 60 * time.Second
+	if v := strings.TrimSpace(os.Getenv("AGENT_CORE_TOOL_TIMEOUT_SEC")); v != "" {
+		if n, err := strconv.Atoi(v); err == nil && n > 0 {
+			d = time.Duration(n) * time.Second
+		}
+	}
+	if d < 5*time.Second {
+		d = 5 * time.Second
+	}
+	if d > 600*time.Second {
+		d = 600 * time.Second
+	}
+	return d
+}
